@article{li_dynamic_2026,
	title = {Dynamic integrated scheduling of machines and {AGVs} in flexible job shop considering {AGV} failures},
	volume = {193},
	issn = {03050548},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0305054826001425},
	doi = {10.1016/j.cor.2026.107524},
	abstract = {Automated Guided Vehicles (AGVs), as critical material handling tools, have been widely adopted in flexible jobshop scheduling to improve production efficiency. However, unexpected AGV failures can easily disrupt material transport, leading to scheduling failures and undermining the reliability and stability of production systems. To address these challenges, this paper proposes an integrated scheduling problem simultaneously considering machine processing, AGV transportation and fault disruption for minimizing the makespan and improving the robustness of scheduling. A similarity-based parallel genetic algorithm (SPGA) is proposed to solve this problem. It adopts a three-layer chromosome encoding structure representing operation sequence, machine assignment, and AGV task allocation, enabling dynamic coordination of processing and transportation resources during decoding. It also incorporates an evolution control strategy based on individual similarity to avoid premature convergence; employs a life cycle-based initialization mechanism to enhance population diversity; and utilizes parallel crossover and mutation operators to balance global exploration and local exploitation. Experimental results on 20 benchmark datasets demonstrate that as the number of AGVs increases, the makespan first decreases rapidly and then gradually stabilizes, consistent with the law of diminishing marginal utility. As the number of AGV failures rises, the small number of failures has limited impacts on scheduling performance; however, when the number of failures reaches a threshold (e.g., four AGVs), the system performance deteriorates sharply or even collapses entirely. Comparisons with existing algorithms reveal that the SPGA achieves better solutions, convergence speeds, and robustness, demonstrating its ability to efficiently generate feasible rescheduling plans and mitigate disruptions under AGV failures.},
	language = {en},
	urldate = {2026-10-08},
	journal = {Computers \& Operations Research},
	author = {Li, Jia and Li, Minghui and Li, Guoqiang and Shi, Xiaoqiu},
	month = sep,
	year = {2026},
	pages = {107524},
	file = {[LLM for Zotero] MinerU cache JGAQ2JR8.zip:/Users/hangyesheng/Zotero/storage/G2CEQY3F/LLM-for-Zotero-MinerU-cache-JGAQ2JR8.zip:application/zip;PDF:/Users/hangyesheng/Zotero/storage/HNVRCH37/Li 等 - 2026 - Dynamic integrated scheduling of machines and AGVs in flexible job shop considering AGV failures.pdf:application/pdf},
}

@misc{he_dynamic_2026,
	title = {Dynamic {Scheduling} for {Flexible} {Manufacturing} {Systems} {Based} on {Multi}-{Agent} {Deep} {Reinforcement} {Learning} and {Petri} {Nets}},
	url = {http://arxiv.org/abs/2606.31737},
	doi = {10.48550/arXiv.2606.31737},
	abstract = {This paper investigates dynamic scheduling for flexible manufacturing systems (FMSs) subject to dynamic events, such as new order arrivals, temporary order cancellations, and machine failures. Traditional methods often face significant challenges in achieving real-time responsiveness under such conditions. To address this issue, the scheduling problem is formulated as a Markov decision process (MDP) with timed Petri nets, where the future evolution of the system depends exclusively on the current marking and the subsequently executed transitions, independent of historical trajectories. The state space and action space of the MDP are constructed using the notion of basis reachability graph (a compact state space representation) of Petri nets to alleviate the state explosion problem, thereby accelerating model training convergence. Meanwhile, a hierarchical dense reward function is constructed by integrating stepwise guidance with terminal evaluation. Then, a multi-agent proximal policy optimization algorithm is employed for model training under the centralized training and decentralized execution paradigm to improve scheduling efficiency. Numerical experiments are conducted involving typical dynamic events, and the results demonstrate that the proposed method can effectively handle dynamic events and achieve superior scheduling performance compared with conventional approaches.},
	language = {en},
	urldate = {2026-10-08},
	publisher = {arXiv},
	author = {He, Zhou and Li, Ning and Liu, Ruotian and Li, Liang and Seatzu, Carla},
	month = jul,
	year = {2026},
	note = {arXiv:2606.31737 [eess.SY]},
	keywords = {Electrical Engineering and Systems Science - Systems and Control},
	file = {[LLM for Zotero] MinerU cache 5DRP89ZV.zip:/Users/hangyesheng/Zotero/storage/X8K437YB/LLM-for-Zotero-MinerU-cache-5DRP89ZV.zip:application/zip;PDF:/Users/hangyesheng/Zotero/storage/5DRP89ZV/He 等 - 2026 - Dynamic Scheduling for Flexible Manufacturing Systems Based on Multi-Agent Deep Reinforcement Learni.pdf:application/pdf},
}

@article{lassoued_flexible_2025,
	title = {Flexible {Manufacturing} {Systems} intralogistics: {Dynamic} optimization of {AGVs} and tool sharing using {Colored}-{Timed} {Petri} {Nets} and actor–critic {RL} with actions masking},
	volume = {82},
	issn = {02786125},
	shorttitle = {Flexible {Manufacturing} {Systems} intralogistics},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0278612525001694},
	doi = {10.1016/j.jmsy.2025.06.017},
	abstract = {Flexible Manufacturing Systems (FMS) are pivotal in optimizing production processes in today’s rapidly evolving manufacturing landscape. This paper advances the traditional job shop scheduling problem by incorporating additional complexities through the simultaneous integration of automated guided vehicles (AGVs) and tool-sharing systems. We propose a novel approach that combines Colored-Timed Petri Nets (CTPNs) with actor–critic model-based reinforcement learning (MBRL), effectively addressing the multifaceted challenges associated with FMS. CTPNs provide a formal modeling structure and dynamic action masking, significantly reducing the action search space, while MBRL ensures adaptability to changing environments through the learned policy. Leveraging the advantages of MBRL, we incorporate a lookahead strategy for optimal positioning of AGVs, improving operational efficiency. Our approach was evaluated on small-sized public benchmarks and a newly developed large-scale benchmark inspired by the Taillard benchmark. The results show that our approach matches traditional methods on smaller instances and outperforms them on larger ones in terms of makespan while achieving a tenfold reduction in computation time. To ensure reproducibility, we propose a gym-compatible environment and an instance generator. Additionally, an ablation study evaluates the contribution of each framework component to its overall performance.},
	language = {en},
	urldate = {2026-10-08},
	journal = {Journal of Manufacturing Systems},
	author = {Lassoued, Sofiene and Baheti, Laxmikant Shrikant and Weiß-Borkowski, Nathalie and Lier, Stefan and Schwung, Andreas},
	month = oct,
	year = {2025},
	pages = {405--419},
	file = {[LLM for Zotero] MinerU cache G393IX7B.zip:/Users/hangyesheng/Zotero/storage/CT4ZZIGW/LLM-for-Zotero-MinerU-cache-G393IX7B.zip:application/zip;PDF:/Users/hangyesheng/Zotero/storage/JWDDF6BX/Lassoued 等 - 2025 - Flexible Manufacturing Systems intralogistics Dynamic optimization of AGVs and tool sharing using C.pdf:application/pdf},
